# Set only when the forum owner has authorized this synchronization.
FORUM_SYNC_AUTHORIZED=false
# Optional authorized Discourse API credentials. Use a dedicated account with
# access only to the topics you are authorized to collect. Never use an admin key.
# FORUM_API_KEY=
# FORUM_API_USERNAME=
# FORUM_DATA_DIR=.forum-data
# Server job: 50 requests per 10 minutes, 12 seconds between requests.
# Enabled schedule waits for authorized access before making any requests.
FORUM_DAILY_ENABLED=true
FORUM_REQUEST_BUDGET=50

# Optional S3 archive; unset bucket for local-only storage.
# FORUM_S3_BUCKET=your-private-bucket
FORUM_S3_PREFIX=archive/
# AWS_REGION=us-west-2
# AWS_PROFILE=default

# First accessible-topic pass runs continuously at 12-second request spacing.
# Routine passes retain the 50-request budget per ten-minute batch.
FORUM_INITIAL_BACKFILL=true
