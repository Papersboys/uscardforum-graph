{
  "name": "uscardforum-graph",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts",
    "test": "node --import tsx --test server/graph.test.ts server/sync.test.ts server/storage.test.ts server/user-auth.test.ts server/daily-job.test.ts src/data.test.ts src/member-sorting.test.ts src/analysis.test.ts src/neighborhood.test.ts src/topics.test.ts src/statistics.test.ts src/user-details.test.ts src/i18n.test.tsx src/topic-links.test.tsx lambda/publication.test.ts",
    "forum:connect": "tsx server/connect-forum.ts",
    "build:lambda": "node scripts/build-lambda.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1161.0",
    "@aws-sdk/client-secrets-manager": "^3.1161.0",
    "@relation-graph/react": "^3.0.0",
    "express": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "concurrently": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.0.0"
  }
}
